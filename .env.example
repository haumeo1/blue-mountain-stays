# Public Supabase project settings. The publishable key is safe to expose to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix this value with PUBLIC_ or commit it. A secret key
# replaces the legacy service_role JWT and bypasses row-level security.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# A long random token used by the owner's private calendar subscription URL.
CALENDAR_FEED_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Canonical deployed URL, without a trailing slash.
PUBLIC_SITE_URL=http://localhost:55000

# Stripe is intentionally off until checkout is implemented and reviewed.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
