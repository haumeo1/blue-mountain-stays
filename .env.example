# Configuration read by server/ (placeholders only — never commit real values).
# Locally: copy to .env.local (git-ignored). Deployed: set in Vercel per environment
# (Production and Preview separately). Test and live data must never share a
# Supabase project, Stripe mode, or webhook secret. See docs/operations.md.

# --- Environment ---------------------------------------------------------------
# staging | production. Anything other than "production" redirects all email to
# EMAIL_TEST_RECIPIENT and refuses live Stripe keys.
APP_ENV=staging
# Canonical origin, no trailing slash. Used for Stripe return URLs, guest links,
# calendar links, and the same-origin check. Staging must match the preview host
# actually serving the app; production uses its own separate domain.
PUBLIC_SITE_URL=http://127.0.0.1:55000

# --- Supabase (separate projects for staging and production) -------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Browser-safe publishable key (returned by /api/config).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only secret key; bypasses RLS. Never expose, never prefix with PUBLIC_.
# Rotate in Supabase, update Vercel, redeploy, then revoke the old key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- Capability and cron secrets (each >= 32 random characters) ---------------
# HMAC key for guest booking and guest calendar tokens. Rotating it invalidates
# outstanding guest links and stops idempotent replays from reproducing the same
# token; plan a re-send of guest links before rotating.
GUEST_TOKEN_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Sent by the scheduler as "Authorization: Bearer <CRON_SECRET>" (header only,
# never a URL query). Rotate by updating Vercel and every external scheduler together.
CRON_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# --- Stripe (Checkout + verified webhooks) ------------------------------------
STRIPE_ENABLED=false
# sk_test_/rk_test_ in staging. A live key is refused unless APP_ENV=production
# AND LIVE_CHECKOUT_ENABLED=true.
STRIPE_SECRET_KEY=
# whsec_ for the endpoint registered in the same Stripe mode/account as the key.
# Rotating: roll the secret in Stripe, update Vercel, redeploy; undelivered events
# are retried by Stripe and verify against the new secret.
STRIPE_WEBHOOK_SECRET=
# Keep false until tax and policies are explicitly confirmed in the owner portal
# and a staging run-through is complete.
LIVE_CHECKOUT_ENABLED=false

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Blue Mountain House <bookings@your-domain.example>".
RESEND_FROM=
# Required outside production: every message is redirected here.
EMAIL_TEST_RECIPIENT=

# --- Local only ---------------------------------------------------------------
# Ignored on any Vercel deployment and when NODE_ENV=production.
DEMO_MODE=false
